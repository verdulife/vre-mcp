# Visual Reference Engine configuration.
# Copy to visual-reference.toml and adjust. Every value below is a working default.

[search]
candidate_limit = 30      # hard cap on candidates kept per search session
per_query_limit = 8       # results requested from the search backend per query
page_fetch_limit = 10     # pages fetched for image extraction (bounded work, no visual cost)
present_min = 3
present_max = 5
language = "es"           # language asked of the agent for explanations

[sources.pi_web_access]
enabled = true
# Path to the pi-web-access MCP server entry point that this adapter reuses over stdio.
# Override with VRE_PI_WEB_ACCESS_SERVER.
server_path = "C:/Users/verdu/.pi/agent/npm/node_modules/pi-web-access/dist/mcp-cli.js"
command = "node"
timeout_seconds = 90

[vision]
enabled = true            # only the agent can confirm what it actually saw; this gates analysis requests
cache_analysis = true
max_image_edge = 1024     # downscale before handing an image to the model
max_image_bytes = 8000000

[storage]
database_path = "data/library.sqlite"

[assets]
store_original_images = false   # default: keep URL + metadata only
store_captures = false

[http]
timeout_seconds = 20
max_response_bytes = 3000000
max_redirects = 3
user_agent = "visual-reference-engine/0.1 (+local MCP server)"

[selection]
# Weights are initial orientation, not a truth claim.
relevance = 0.35
visual_quality = 0.25
usefulness = 0.25
novelty = 0.15
